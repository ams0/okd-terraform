# ---------------------------------------------------------------------------
# Proxmox connection
# ---------------------------------------------------------------------------
proxmox_endpoint  = "https://pve1.example.lan:8006/"
proxmox_api_token = "terraform@pve!provider=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Masters/workers are placed round-robin over this list. With 3 masters over 3
# nodes, each hypervisor holds exactly one, so losing a node cannot take out
# the whole control plane. A single-element list pins everything to one node.
proxmox_nodes = ["pve1", "pve2", "pve3"]

# An address Terraform can SSH into for each node. Attaching ignition uses
# `qm set --args` on the node itself, because the QEMU args option is root-only
# and no API token can ever satisfy that check.
proxmox_node_hosts = {
  pve1 = "10.0.0.11"
  pve2 = "10.0.0.12"
  pve3 = "10.0.0.13"
}

# Snippet upload (the ignition files) goes over SSH, not the REST API.
proxmox_ssh_username = "root"

# Datastores. Before the first apply, enable `Snippets` on
# proxmox_snippet_datastore under Datacenter > Storage — it is off by default
# and ignition delivery needs it. The image uses the `iso` content type, which
# is already enabled.
# With more than one node in proxmox_nodes, the image and snippet stores MUST
# be shared: both are uploaded once via the first node, and whichever node runs
# the VM has to read them. CephFS works; Ceph RBD cannot hold snippets at all.
# For any mounted store the snippets path is <storage path>/snippets, i.e.
# /mnt/pve/<storage-id>/snippets -- only the built-in `local` store lives under
# /var/lib/vz. Check with: pvesh get /storage/<id> --output-format json
proxmox_datastore         = "ceph-vm"
proxmox_iso_datastore     = "cephfs"
proxmox_snippet_datastore = "cephfs"
proxmox_snippet_path      = "/mnt/pve/cephfs/snippets"

proxmox_bridge = "vmbr0"
# proxmox_vlan_id = 20

# ---------------------------------------------------------------------------
# Cluster networking
#
# api_vip and ingress_vip must be free addresses on machine_network_cidr and
# must NOT be inside the DHCP pool — keepalived assigns them, not DHCP.
# ---------------------------------------------------------------------------
machine_network_cidr = "192.168.228.0/24"
api_vip              = "192.168.228.50"
ingress_vip          = "192.168.228.51"

# Guest-side NIC name keepalived binds the VIPs to. SCOS with a virtio NIC on
# Proxmox normally gets ens18; check `ip link` on a booted node if the VIPs
# never come up.
vrrp_interface = "ens18"

# ---------------------------------------------------------------------------
# Node image
#
# Use the SCOS build matching the openshift-install release in .bin/
# (`.bin/openshift-install version`).
# ---------------------------------------------------------------------------
# For 4.22.0-okd-scos.8 / SCOS build 10.0.20251103-0:
scos_image_url      = "https://rhcos.mirror.openshift.com/art/storage/prod/streams/c10s/builds/10.0.20251103-0/x86_64/scos-10.0.20251103-0-qemu.x86_64.qcow2.gz"
scos_image_checksum = "5b8f269822647f1471c4ae6aab445a1a4e3bce1522fcb566a507f4881c437a0a"

# ---------------------------------------------------------------------------
# Topology
#   master_count=3, worker_count=0  -> compact (default)
#   master_count=3, worker_count=N  -> HA + workers
#   master_count=1, worker_count=0  -> Single Node OpenShift
# ---------------------------------------------------------------------------
master_count = 3
worker_count = 0

# After the first plan, run `terraform output node_mac_addresses` and create
# DHCP reservations for each. HAProxy's backend list needs stable
# control-plane addresses across rebuilds.

# ---------------------------------------------------------------------------
# DNS + cert-manager (still Azure — Proxmox has no DNS service)
# ---------------------------------------------------------------------------
base_domain             = "example.com"
dns_zone_resource_group = "resources"
letsencrypt_email       = "you@example.com"

cert_manager_azure_client_id       = "00000000-0000-0000-0000-000000000000"
cert_manager_azure_client_secret   = "REDACTED"
cert_manager_azure_tenant_id       = "00000000-0000-0000-0000-000000000000"
cert_manager_azure_subscription_id = "00000000-0000-0000-0000-000000000000"

ssh_public_key = "ssh-ed25519 AAAA... you@host"
