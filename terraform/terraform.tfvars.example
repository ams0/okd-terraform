# ---------------------------------------------------------------------------
# Proxmox connection
# ---------------------------------------------------------------------------
proxmox_endpoint  = "https://pve.lan:8006/"
proxmox_api_token = "root@pam!terraform=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_node      = "pve"

# Snippet upload (the ignition files) goes over SSH, not the REST API.
proxmox_ssh_username = "root"

# Datastores. Before the first apply, under Datacenter > Storage enable:
#   - `Snippets` on proxmox_snippet_datastore  (ignition delivery)
#   - `Import`   on proxmox_iso_datastore      (SCOS qcow2)
# Neither is on by default.
proxmox_datastore         = "local-lvm"
proxmox_iso_datastore     = "local"
proxmox_snippet_datastore = "local"
proxmox_snippet_path      = "/var/lib/vz/snippets"

proxmox_bridge = "vmbr0"
# proxmox_vlan_id = 20

# ---------------------------------------------------------------------------
# Cluster networking
#
# api_vip and ingress_vip must be free addresses on machine_network_cidr and
# must NOT be inside the DHCP pool — keepalived assigns them, not DHCP.
# ---------------------------------------------------------------------------
machine_network_cidr = "192.168.1.0/24"
api_vip              = "192.168.1.10"
ingress_vip          = "192.168.1.11"

# Guest-side NIC name keepalived binds the VIPs to. SCOS with a virtio NIC on
# Proxmox normally gets ens18; check `ip link` on a booted node if the VIPs
# never come up.
vrrp_interface = "ens18"

# ---------------------------------------------------------------------------
# Node image
#
# Use the SCOS build matching the openshift-install release in .bin/
# (`.bin/openshift-install version`).
# ---------------------------------------------------------------------------
scos_image_url      = "https://.../scos-9.0.qcow2"
scos_image_checksum = null

# ---------------------------------------------------------------------------
# Topology
#   master_count=3, worker_count=0  -> compact (default)
#   master_count=3, worker_count=N  -> HA + workers
#   master_count=1, worker_count=0  -> Single Node OpenShift
# ---------------------------------------------------------------------------
master_count = 3
worker_count = 0

# After the first plan, run `terraform output node_mac_addresses` and create
# DHCP reservations for each. HAProxy's backend list needs stable
# control-plane addresses across rebuilds.

# ---------------------------------------------------------------------------
# DNS + cert-manager (still Azure — Proxmox has no DNS service)
# ---------------------------------------------------------------------------
base_domain             = "example.com"
dns_zone_resource_group = "resources"
letsencrypt_email       = "you@example.com"

cert_manager_azure_client_id       = "00000000-0000-0000-0000-000000000000"
cert_manager_azure_client_secret   = "REDACTED"
cert_manager_azure_tenant_id       = "00000000-0000-0000-0000-000000000000"
cert_manager_azure_subscription_id = "00000000-0000-0000-0000-000000000000"

ssh_public_key = "ssh-ed25519 AAAA... you@host"
